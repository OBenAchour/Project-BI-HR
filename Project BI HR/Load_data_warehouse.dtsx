                <component
                  refId="Package\SEQ_Dimensions\DFT_DIM_CONTRAT\SRC_dim_contrat"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SRC_dim_contrat"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- dim_contrat (SCD 1) : combinaisons type de contrat x position
SELECT b.type_contrat, b.position,
       CAST(CASE WHEN b.type_contrat IN (N'CDD', N'CIVP') THEN 1 ELSE 0 END AS bit) AS is_contrat_court,
       MAX(b._LoadDate) AS src_load_date, MAX(b._SourceFile) AS src_file, MAX(b._BatchId) AS src_batch_id
FROM (
    SELECT CAST(LTRIM(RTRIM(e.CODE)) AS nvarchar(255))                                                 AS employe_bk,
           CAST(N'Technique' AS nvarchar(20))                                                          AS population,
           CAST(NULLIF(LTRIM(RTRIM(e.DEP_ID)), N'') AS nvarchar(255))                                   AS departement_bk,
           CAST(ISNULL(NULLIF(LTRIM(RTRIM(e.TYPE_CONTRACT)), N''), N'Inconnu') AS nvarchar(50))        AS type_contrat,
           CAST(ISNULL(NULLIF(LTRIM(RTRIM(e.POSITION)), N''), N'Inconnu') AS nvarchar(255))            AS position,
           CAST(ISNULL(NULLIF(LTRIM(RTRIM(e.GRADE)), N''), N'Inconnu') AS nvarchar(255))               AS grade,
           CAST(ISNULL(NULLIF(LTRIM(RTRIM(e.RANK)), N''), N'Inconnu') AS nvarchar(255))                AS rang,
           CAST(ISNULL(NULLIF(LTRIM(RTRIM(e.ACTIVITY)), N''), N'Inconnu') AS nvarchar(255))            AS activite,
           CAST(NULLIF(LOWER(LTRIM(RTRIM(e.LEAVE_TYPE))), N'') AS nvarchar(50))                         AS type_conge,
           CAST(CASE LTRIM(RTRIM(e.TENURE)) WHEN N'1' THEN N'Titularisé' WHEN N'0' THEN N'Non titularisé'
                ELSE N'Inconnu' END AS nvarchar(50))                                                   AS tenure_statut,
           TRY_CONVERT(date, LEFT(e.STARTING_DATE, 10), 23)                                            AS date_embauche,
           TRY_CONVERT(date, LEFT(e.CONTRACT_START, 10), 23)                                           AS date_debut_contrat,
           TRY_CONVERT(date, LEFT(e.CONTRACT_END, 10), 23)                                             AS date_fin_contrat,
           TRY_CONVERT(float, e.SALARY)                                                                AS salaire,
           TRY_CONVERT(float, e.HOURS)                                                                 AS heures,
           CAST(NULL AS float)                                                                         AS heures_sup,
           TRY_CONVERT(float, e.EXP_YEARS)                                                             AS experience,
           TRY_CONVERT(float, e.LEAVE_CONSUMED)                                                        AS conges_consommes,
           TRY_CONVERT(float, e.LEAVE_BALANCE)                                                         AS solde_conges,
           e._LoadDate, e._SourceFile, e._BatchId
    FROM stg.emp_data e
    UNION ALL
    SELECT CAST(LTRIM(RTRIM(a.ID_Employee)) AS nvarchar(255)),
           CAST(N'Administratif' AS nvarchar(20)),
           CAST(NULLIF(LTRIM(RTRIM(a.DEP_ID)), N'') AS nvarchar(255)),
           CAST(ISNULL(NULLIF(LTRIM(RTRIM(a.TYPE_CONTRACT)), N''), N'Inconnu') AS nvarchar(50)),
           CAST(ISNULL(NULLIF(LTRIM(RTRIM(a.POSITION)), N''), N'Administration') AS nvarchar(255)),
           CAST(ISNULL(NULLIF(LTRIM(RTRIM(a.Grade)), N''), N'Inconnu') AS nvarchar(255)),
           CAST(N'Non applicable' AS nvarchar(255)),
           CAST(N'Non applicable' AS nvarchar(255)),
           CAST(NULLIF(LOWER(LTRIM(RTRIM(a.LAST_LEAVE_TYPE))), N'') AS nvarchar(50)),
           CAST(CASE LTRIM(RTRIM(a.TENURE)) WHEN N'1' THEN N'Titularisé' WHEN N'0' THEN N'Non titularisé'
                ELSE N'Inconnu' END AS nvarchar(50)),
           TRY_CONVERT(date, LEFT(a.STARTING_DATE, 10), 23),
           TRY_CONVERT(date, LEFT(a.CONTRACT_START, 10), 23),
           TRY_CONVERT(date, LEFT(a.CONTRACT_END, 10), 23),
           TRY_CONVERT(float, a.SALARY),
           CAST(NULL AS float),
           TRY_CONVERT(float, a.extra_hour),
           TRY_CONVERT(float, a.EXP_YEARS),
           TRY_CONVERT(float, a.LEAVE_CONSUMED),
           TRY_CONVERT(float, a.LEAVE_BALANCE),
           a._LoadDate, a._SourceFile, a._BatchId
    FROM stg.administration_data a
) b
WHERE NULLIF(b.employe_bk, N'') IS NOT NULL
GROUP BY b.type_contrat, b.position</property>
