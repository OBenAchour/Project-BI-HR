                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- dim_departement (SCD 2) : départements et pôle de rattachement
SELECT d.departement_bk, d.departement, d.capacite, d.pole,
       CAST(h.row_hash AS binary(32))             AS row_hash,
       CONVERT(varchar(64), h.row_hash, 2)        AS row_hash_hex,
       d.src_load_date, d.src_file, d.src_batch_id
FROM (
    SELECT CAST(LTRIM(RTRIM(s.ID_DEP)) AS nvarchar(255))                            AS departement_bk,
           CAST(LTRIM(RTRIM(s.DEP)) AS nvarchar(255))                               AS departement,
           TRY_CONVERT(int, TRY_CONVERT(float, s.CAPACITY))                         AS capacite,
           CAST(CASE WHEN LTRIM(RTRIM(s.ID_DEP)) = N'DEP_ADMIN00' THEN N'Administratif'
                     ELSE N'Technique' END AS nvarchar(20))                         AS pole,
           s._LoadDate AS src_load_date, s._SourceFile AS src_file, s._BatchId AS src_batch_id
    FROM stg.departments s
    WHERE NULLIF(LTRIM(RTRIM(s.ID_DEP)), N'') IS NOT NULL
) d
CROSS APPLY (SELECT HASHBYTES('SHA2_256', CONCAT(ISNULL(d.departement, N'~'), N'|', ISNULL(CONVERT(nvarchar(20), d.capacite), N'~'),
                                                 N'|', ISNULL(d.pole, N'~'))) AS row_hash) h</property>
