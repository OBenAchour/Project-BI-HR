                <component
                  refId="Package\SEQ_Faits\DFT_FACT_POINTAGE\SRC_fact_pointage"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SRC_fact_pointage"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- fact_pointage : pointages techniques (M/D/YYYY, H:MM:SS) + administratifs (YYYY-MM-DD, HH:MM)
-- Règles (EDA) : retard si arrivée &gt; 08:30, heures sup au-delà de 8 h travaillées.
SELECT p.source_pointage,
       p.employe_bk,
       p.departement_bk,
       p.code_taux_hs,
       YEAR(p.jour) * 10000 + MONTH(p.jour) * 100 + DAY(p.jour)                         AS date_key,
       CAST(ISNULL(DATEPART(HOUR, t.hd) * 100 + DATEPART(MINUTE, t.hd), -1) AS smallint) AS heure_debut_key,
       CAST(ISNULL(DATEPART(HOUR, t.hf) * 100 + DATEPART(MINUTE, t.hf), -1) AS smallint) AS heure_fin_key,
       t.hd AS heure_debut, t.hp AS heure_pause, t.hr AS heure_reprise, t.hf AS heure_fin,
       m.mp AS minutes_pause,
       m.mt AS minutes_travaillees,
       CAST(m.mt / 60.0 AS decimal(5, 2))                                                AS heures_travaillees,
       CAST(CASE WHEN m.mt IS NULL THEN NULL WHEN m.mt &gt; 480 THEN (m.mt - 480) / 60.0 ELSE 0 END
            AS decimal(5, 2))                                                            AS heures_sup,
       CASE WHEN t.hd IS NULL THEN NULL WHEN t.hd &gt; '08:30' THEN DATEDIFF(MINUTE, '08:30', t.hd) ELSE 0 END
                                                                                         AS minutes_retard,
       CAST(CASE WHEN t.hd &gt; '08:30' THEN 1 ELSE 0 END AS bit)                           AS is_retard,
       CAST(CASE WHEN m.mt &gt; 480 THEN 1 ELSE 0 END AS bit)                               AS is_heures_sup,
       CAST(CASE WHEN m.mt &gt;= 0 AND m.mt &lt; 60 THEN 1 ELSE 0 END AS bit)                  AS is_journee_moins_1h,
       CAST(CASE WHEN m.mt &lt; 0 OR m.mp &lt; 0 THEN 1 ELSE 0 END AS bit)                     AS is_duree_negative,
       CAST(CASE WHEN t.hd IS NULL OR t.hp IS NULL OR t.hr IS NULL OR t.hf IS NULL THEN 1 ELSE 0 END AS bit)
                                                                                         AS is_heure_illisible,
       p._LoadDate AS src_load_date, p._SourceFile AS src_file, p._BatchId AS src_batch_id
FROM (
    SELECT CAST(N'Technique' AS nvarchar(10))                                  AS source_pointage,
           CAST(LTRIM(RTRIM(a.ID_Employee)) AS nvarchar(255))                  AS employe_bk,
           CAST(NULLIF(LTRIM(RTRIM(e.DEP_ID)), N'') AS nvarchar(255))           AS departement_bk,
           CAST(CASE WHEN e.POSITION = N'Vacataire' THEN N'VACATAIRE' ELSE N'HS_PERMANENT' END AS nvarchar(30))
                                                                               AS code_taux_hs,
           TRY_CONVERT(date, LTRIM(RTRIM(a.[Date])), 101)                      AS jour,
           a.StartTime, a.BreakTime, a.ResumeTime, a.EndTime, a._LoadDate, a._SourceFile, a._BatchId
    FROM stg.attendance_tech_2023 a
    LEFT JOIN stg.emp_data e ON e.CODE = a.ID_Employee
    UNION ALL
    SELECT CAST(N'Admin' AS nvarchar(10)),
           CAST(LTRIM(RTRIM(a.ID_Employee)) AS nvarchar(255)),
           CAST(N'DEP_ADMIN00' AS nvarchar(255)),
           CAST(N'HS_ADMIN' AS nvarchar(30)),
           TRY_CONVERT(date, LEFT(LTRIM(RTRIM(a.[Date])), 10), 23),
           a.StartTime, a.BreakTime, a.ResumeTime, a.EndTime, a._LoadDate, a._SourceFile, a._BatchId
    FROM stg.attendance_admin_2023 a
) p
CROSS APPLY (SELECT TRY_CONVERT(time(0), NULLIF(LTRIM(RTRIM(p.StartTime)), N''))  AS hd,
                    TRY_CONVERT(time(0), NULLIF(LTRIM(RTRIM(p.BreakTime)), N''))  AS hp,
                    TRY_CONVERT(time(0), NULLIF(LTRIM(RTRIM(p.ResumeTime)), N'')) AS hr,
                    TRY_CONVERT(time(0), NULLIF(LTRIM(RTRIM(p.EndTime)), N''))    AS hf) t
CROSS APPLY (SELECT DATEDIFF(MINUTE, t.hp, t.hr)                                AS mp,
                    DATEDIFF(MINUTE, t.hd, t.hf) - DATEDIFF(MINUTE, t.hp, t.hr) AS mt) m
WHERE NULLIF(p.employe_bk, N'') IS NOT NULL
  AND p.jour IS NOT NULL</property>
