                <component
                  refId="Package\SEQ_Faits\DFT_FACT_FORMATION\SRC_fact_formation"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SRC_fact_formation"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- fact_formation : inscriptions (emp_data.ID_TRAINING = liste JSON d'identifiants de cours)
-- Seuls les identifiants présents dans le catalogue sont retenus.
SELECT CAST(LTRIM(RTRIM(e.CODE)) AS nvarchar(255))            AS employe_bk,
       CAST(NULLIF(LTRIM(RTRIM(e.DEP_ID)), N'') AS nvarchar(255)) AS departement_bk,
       CAST(LTRIM(RTRIM(j.value)) AS nvarchar(255))           AS cours_bk,
       MAX(e._LoadDate) AS src_load_date, MAX(e._SourceFile) AS src_file, MAX(e._BatchId) AS src_batch_id
FROM stg.emp_data e
CROSS APPLY OPENJSON(CASE WHEN ISJSON(CAST(e.ID_TRAINING AS nvarchar(max))) = 1
                          THEN CAST(e.ID_TRAINING AS nvarchar(max)) END) j
WHERE NULLIF(LTRIM(RTRIM(e.CODE)), N'') IS NOT NULL
  AND EXISTS (SELECT 1 FROM stg.coursera_trainings c WHERE LTRIM(RTRIM(c.course_id)) = LTRIM(RTRIM(j.value)))
GROUP BY LTRIM(RTRIM(e.CODE)), NULLIF(LTRIM(RTRIM(e.DEP_ID)), N''), LTRIM(RTRIM(j.value))</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
                    <property
                      dataType="System.Int32"
                      description="Specifies the column code page to use when code page information is unavailable from the data source."
                      name="DefaultCodePage">1252</property>
                    <property
                      dataType="System.Boolean"
                      description="Forces the use of the DefaultCodePage property value when describing character data."
                      name="AlwaysUseDefaultCodePage">false</property>
                    <property
