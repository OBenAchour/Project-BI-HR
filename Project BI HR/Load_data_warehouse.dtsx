                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- dim_taux_horaire (SCD 2) : grille de taux du fichier extrainfos.txt
SELECT t.code_taux, t.libelle, t.valeur_taux,
       CAST(h.row_hash AS binary(32))             AS row_hash,
       CONVERT(varchar(64), h.row_hash, 2)        AS row_hash_hex,
       t.src_load_date, t.src_file, t.src_batch_id
FROM (
    SELECT CAST(CASE WHEN s.libelle LIKE N'%vacataire%' THEN N'VACATAIRE'
                     WHEN s.libelle LIKE N'%perm%'      THEN N'HS_PERMANENT'
                     WHEN s.libelle LIKE N'%admin%'     THEN N'HS_ADMIN'
                     ELSE UPPER(LEFT(LTRIM(RTRIM(s.libelle)), 30)) END AS nvarchar(30))      AS code_taux,
           CAST(LTRIM(RTRIM(REPLACE(REPLACE(s.libelle, N'"', N''), N'  ', N' '))) AS nvarchar(255)) AS libelle,
           TRY_CONVERT(decimal(10, 2), TRY_CONVERT(float, LTRIM(RTRIM(s.valeur))))              AS valeur_taux,
           s._LoadDate AS src_load_date, s._SourceFile AS src_file, s._BatchId AS src_batch_id
    FROM stg.extrainfos s
    WHERE NULLIF(LTRIM(RTRIM(s.libelle)), N'') IS NOT NULL
) t
CROSS APPLY (SELECT HASHBYTES('SHA2_256', CONCAT(ISNULL(t.libelle, N'~'), N'|',
                                                 ISNULL(CONVERT(nvarchar(20), t.valeur_taux), N'~'))) AS row_hash) h</property>
