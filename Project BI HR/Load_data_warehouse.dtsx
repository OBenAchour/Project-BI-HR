                <component
                  refId="Package\SEQ_Dimensions\DFT_DIM_EMPLOYE\SRC_dim_employe"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SRC_dim_employe"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- dim_employe (SCD 2) : personnel technique (emp_data) + administratif (administration_data)
SELECT e.employe_bk, e.population, e.numero_matricule, e.nom_employe, e.genre, e.adresse, e.adresse_mission,
       e.statut_marital, e.email, e.langue, e.universite_diplome, e.type_diplome, e.canal_recrutement,
       e.technologies_brut,
       CAST(h.row_hash AS binary(32))             AS row_hash,
       CONVERT(varchar(64), h.row_hash, 2)        AS row_hash_hex,
       e.src_load_date, e.src_file, e.src_batch_id
FROM (
    SELECT CAST(LTRIM(RTRIM(t.CODE)) AS nvarchar(255))                              AS employe_bk,
           CAST(N'Technique' AS nvarchar(20))                                       AS population,
           CAST(LTRIM(RTRIM(t.REGISTRATION_NUMBER)) AS nvarchar(255))               AS numero_matricule,
           CAST(LTRIM(RTRIM(t.NAME_EMP)) AS nvarchar(255))                          AS nom_employe,
           CAST(LEFT(LTRIM(RTRIM(t.GENDER)), 10) AS nvarchar(10))                   AS genre,
           CAST(LTRIM(RTRIM(t.ADRESS)) AS nvarchar(500))                            AS adresse,
           CAST(LTRIM(RTRIM(t.ADRESSE_MISSION)) AS nvarchar(500))                   AS adresse_mission,
           CAST(CASE LTRIM(RTRIM(t.MARITAL_STATUS)) WHEN N'1' THEN N'Marié(e)' WHEN N'0' THEN N'Non marié(e)'
                END AS nvarchar(255))                                               AS statut_marital,
           CAST(LOWER(LTRIM(RTRIM(t.EMAIL))) AS nvarchar(255))                      AS email,
           CAST(LOWER(LTRIM(RTRIM(t.LANGUAGE))) AS nvarchar(255))                   AS langue,
           CAST(LTRIM(RTRIM(t.GRAD_UNIVERSITY)) AS nvarchar(255))                   AS universite_diplome,
           CAST(LTRIM(RTRIM(t.TYPE_DIPLOMA)) AS nvarchar(255))                      AS type_diplome,
           CAST(REPLACE(LOWER(LTRIM(RTRIM(t.SOURCE_of_employment))), N' ', N'_') AS nvarchar(255)) AS canal_recrutement,
           CAST(t.TECHNOLOGIES AS nvarchar(max))                                    AS technologies_brut,
           t._LoadDate AS src_load_date, t._SourceFile AS src_file, t._BatchId AS src_batch_id
    FROM stg.emp_data t
    UNION ALL
    SELECT CAST(LTRIM(RTRIM(a.ID_Employee)) AS nvarchar(255)),
           CAST(N'Administratif' AS nvarchar(20)),
           CAST(LTRIM(RTRIM(a.REGISTRATION_NUMBER)) AS nvarchar(255)),
           CAST(LTRIM(RTRIM(a.NAME_EMP)) AS nvarchar(255)),
           CAST(LEFT(LTRIM(RTRIM(a.GENDER)), 10) AS nvarchar(10)),
           CAST(LTRIM(RTRIM(a.ADDRESS)) AS nvarchar(500)),
           CAST(NULL AS nvarchar(500)),
           CAST(CASE LTRIM(RTRIM(a.MARITAL_STATUS)) WHEN N'1' THEN N'Marié(e)' WHEN N'0' THEN N'Non marié(e)'
                END AS nvarchar(255)),
           CAST(LOWER(LTRIM(RTRIM(a.EMAIL))) AS nvarchar(255)),
           CAST(LOWER(LTRIM(RTRIM(a.LANGUAGE))) AS nvarchar(255)),
           CAST(NULL AS nvarchar(255)),
           CAST(LTRIM(RTRIM(a.TYPE_DIPLOMA)) AS nvarchar(255)),
           CAST(REPLACE(LOWER(LTRIM(RTRIM(a.SOURCE_of_employment))), N' ', N'_') AS nvarchar(255)),
           CAST(NULL AS nvarchar(max)),
           a._LoadDate, a._SourceFile, a._BatchId
    FROM stg.administration_data a
) e
CROSS APPLY (SELECT HASHBYTES('SHA2_256', CONCAT(
        ISNULL(e.population, N'~'), N'|', ISNULL(e.numero_matricule, N'~'), N'|', ISNULL(e.nom_employe, N'~'), N'|',
        ISNULL(e.genre, N'~'), N'|', ISNULL(e.adresse, N'~'), N'|', ISNULL(e.adresse_mission, N'~'), N'|',
        ISNULL(e.statut_marital, N'~'), N'|', ISNULL(e.email, N'~'), N'|', ISNULL(e.langue, N'~'), N'|',
        ISNULL(e.universite_diplome, N'~'), N'|', ISNULL(e.type_diplome, N'~'), N'|',
        ISNULL(e.canal_recrutement, N'~'), N'|', ISNULL(e.technologies_brut, N'~'))) AS row_hash) h
WHERE NULLIF(e.employe_bk, N'') IS NOT NULL</property>
