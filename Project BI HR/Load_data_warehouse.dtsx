                <component
                  refId="Package\SEQ_Ponts\DFT_BRIDGE_EMPLOYE_TECHNOLOGIE\SRC_bridge_employe_technologie"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SRC_bridge_employe_technologie"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- bridge_employe_technologie : éclatement de emp_data.TECHNOLOGIES
SELECT k.employe_bk,
       CAST(LOWER(LEFT(k.libelle, 255)) AS nvarchar(255)) AS competence_bk,
       MAX(k._LoadDate) AS src_load_date, MAX(k._SourceFile) AS src_file, MAX(k._BatchId) AS src_batch_id
FROM (
    SELECT CAST(LTRIM(RTRIM(e.CODE)) AS nvarchar(255)) AS employe_bk, CAST(NULL AS nvarchar(255)) AS cours_bk,
           LTRIM(RTRIM(REPLACE(REPLACE(s.value, NCHAR(13), N''), NCHAR(10), N''))) AS libelle,
           e._LoadDate, e._SourceFile, e._BatchId
    FROM stg.emp_data e
    CROSS APPLY STRING_SPLIT(CAST(e.TECHNOLOGIES AS nvarchar(max)), N',') s
    UNION ALL
    SELECT NULL, CAST(LTRIM(RTRIM(c.course_id)) AS nvarchar(255)),
           LTRIM(RTRIM(REPLACE(REPLACE(s.value, NCHAR(13), N''), NCHAR(10), N''))),
           c._LoadDate, c._SourceFile, c._BatchId
    FROM stg.coursera_trainings c
    CROSS APPLY STRING_SPLIT(REPLACE(CAST(c.Skills AS nvarchar(max)), N'  ', NCHAR(31)), NCHAR(31)) s
    WHERE NULLIF(LTRIM(RTRIM(c.course_id)), N'') IS NOT NULL
) k
WHERE k.employe_bk IS NOT NULL AND k.libelle &lt;&gt; N''
GROUP BY k.employe_bk, LOWER(LEFT(k.libelle, 255))</property>
                    <property
