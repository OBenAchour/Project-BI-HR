                <component
                  refId="Package\SEQ_Dimensions\DFT_DIM_COURS\SRC_dim_cours"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SRC_dim_cours"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- dim_cours (SCD 1) : catalogue Coursera (une ligne par course_id)
SELECT c.cours_bk, c.id_course, c.nom_cours, c.universite, c.niveau_difficulte, c.note_cours, c.url_cours,
       c.description_cours, c.competences_brut,
       CONVERT(varchar(64), HASHBYTES('SHA2_256', CONCAT(
           ISNULL(c.id_course, N'~'), N'|', ISNULL(c.nom_cours, N'~'), N'|', ISNULL(c.universite, N'~'), N'|',
           ISNULL(c.niveau_difficulte, N'~'), N'|', ISNULL(CONVERT(nvarchar(10), c.note_cours), N'~'), N'|',
           ISNULL(c.url_cours, N'~'), N'|', ISNULL(c.description_cours, N'~'), N'|',
           ISNULL(c.competences_brut, N'~'))), 2) AS row_hash_hex,
       c.src_load_date, c.src_file, c.src_batch_id
FROM (
    SELECT CAST(LTRIM(RTRIM(s.course_id)) AS nvarchar(255))                       AS cours_bk,
           CAST(NULLIF(LTRIM(RTRIM(s.id_course)), N'') AS nvarchar(255))          AS id_course,
           CAST(LTRIM(RTRIM(s.[Course Name])) AS nvarchar(500))                   AS nom_cours,
           CAST(LTRIM(RTRIM(s.University)) AS nvarchar(255))                      AS universite,
           CAST(LTRIM(RTRIM(s.[Difficulty Level])) AS nvarchar(255))              AS niveau_difficulte,
           TRY_CONVERT(decimal(3, 2), TRY_CONVERT(float, s.[Course Rating]))      AS note_cours,
           CAST(LTRIM(RTRIM(s.[Course URL])) AS nvarchar(500))                    AS url_cours,
           CAST(s.[Course Description] AS nvarchar(max))                          AS description_cours,
           CAST(s.Skills AS nvarchar(max))                                        AS competences_brut,
           s._LoadDate AS src_load_date, s._SourceFile AS src_file, s._BatchId AS src_batch_id,
           ROW_NUMBER() OVER (PARTITION BY LTRIM(RTRIM(s.course_id)) ORDER BY s._LoadDate DESC) AS rn
    FROM stg.coursera_trainings s
    WHERE NULLIF(LTRIM(RTRIM(s.course_id)), N'') IS NOT NULL
) c
WHERE c.rn = 1</property>
