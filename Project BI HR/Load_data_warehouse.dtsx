    <DTS:Executable
      DTS:refId="Package\SEQ_Initialisation"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Membres inconnus, dim_date, dim_heure et junk dimensions (scripts idempotents)."
      DTS:DTSID="{59C0F7A9-5906-4B55-983A-D0EADCBDCE51}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="SEQ_Initialisation">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\SEQ_Initialisation\SQL_Generer_Dim_Date"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DTSID="{D197386E-0D13-4BCD-B62C-9F76CAE308E1}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Generer_Dim_Date"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7186E69B-4145-4297-BC0B-066F953FF763}"
              SQLTask:SqlStatementSource="-- dim_date : calendrier 1950-2040 (couvre embauches, contrats, pointages et snapshots).&#xA;-- Jours fériés : fêtes nationales tunisiennes à date fixe (les fêtes religieuses, mobiles, ne sont pas gérées).&#xA;-- Idempotent : n'insère que les dates absentes.&#xA;SET NOCOUNT ON;&#xA;DECLARE @debut date = '19500101', @fin date = '20401231';&#xA;&#xA;WITH n AS (&#xA;    SELECT TOP (DATEDIFF(DAY, @debut, @fin) + 1)&#xA;           ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS i&#xA;    FROM sys.all_objects a CROSS JOIN sys.all_objects b&#xA;), d AS (&#xA;    SELECT DATEADD(DAY, i, @debut) AS dt FROM n&#xA;), c AS (&#xA;    SELECT dt,&#xA;           YEAR(dt) * 10000 + MONTH(dt) * 100 + DAY(dt) AS date_key,&#xA;           DATEDIFF(DAY, '19000101', dt) % 7 + 1 AS jsn,          -- 1 = lundi (le 01/01/1900 était un lundi)&#xA;           CASE&#xA;               WHEN MONTH(dt) = 1  AND DAY(dt) = 1  THEN N'Jour de l''An'&#xA;               WHEN MONTH(dt) = 1  AND DAY(dt) = 14 AND YEAR(dt) BETWEEN 2012 AND 2020 THEN N'Fête de la Révolution et de la Jeunesse'&#xA;               WHEN MONTH(dt) = 3  AND DAY(dt) = 20 THEN N'Fête de l''Indépendance'&#xA;               WHEN MONTH(dt) = 4  AND DAY(dt) = 9  THEN N'Journée des Martyrs'&#xA;               WHEN MONTH(dt) = 5  AND DAY(dt) = 1  THEN N'Fête du Travail'&#xA;               WHEN MONTH(dt) = 7  AND DAY(dt) = 25 THEN N'Fête de la République'&#xA;               WHEN MONTH(dt) = 8  AND DAY(dt) = 13 THEN N'Fête de la Femme'&#xA;               WHEN MONTH(dt) = 10 AND DAY(dt) = 15 THEN N'Fête de l''Évacuation'&#xA;               WHEN MONTH(dt) = 12 AND DAY(dt) = 17 AND YEAR(dt) &gt;= 2021 THEN N'Fête de la Révolution'&#xA;           END AS libelle_ferie&#xA;    FROM d&#xA;)&#xA;INSERT dw.dim_date (date_key, date_complete, jour_semaine_num, jour_semaine, semaine_iso, mois_num, mois,&#xA;                    trimestre, annee, annee_mois, is_jour_ouvre, is_ferie, libelle_ferie)&#xA;SELECT c.date_key,&#xA;       c.dt,&#xA;       c.jsn,&#xA;       CHOOSE(c.jsn, N'Lundi', N'Mardi', N'Mercredi', N'Jeudi', N'Vendredi', N'Samedi', N'Dimanche'),&#xA;       DATEPART(ISO_WEEK, c.dt),&#xA;       MONTH(c.dt),&#xA;       CHOOSE(MONTH(c.dt), N'Janvier', N'Février', N'Mars', N'Avril', N'Mai', N'Juin',&#xA;                           N'Juillet', N'Août', N'Septembre', N'Octobre', N'Novembre', N'Décembre'),&#xA;       DATEPART(QUARTER, c.dt),&#xA;       YEAR(c.dt),&#xA;       CONVERT(char(7), c.dt, 126),&#xA;       CASE WHEN c.jsn &lt;= 5 AND c.libelle_ferie IS NULL THEN 1 ELSE 0 END,&#xA;       CASE WHEN c.libelle_ferie IS NULL THEN 0 ELSE 1 END,&#xA;       c.libelle_ferie&#xA;FROM c&#xA;WHERE NOT EXISTS (SELECT 1 FROM dw.dim_date x WHERE x.date_key = c.date_key);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\SEQ_Initialisation\SQL_Generer_Dim_Heure"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DTSID="{482F9FCF-AE54-4A9F-946B-F1E8D47E9352}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Generer_Dim_Heure"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7186E69B-4145-4297-BC0B-066F953FF763}"
              SQLTask:SqlStatementSource="-- dim_heure : une ligne par minute (heure_key = HHMM, ex. 830 = 08:30), tranche de 15 minutes.&#xA;-- Idempotent : n'insère que les minutes absentes.&#xA;SET NOCOUNT ON;&#xA;&#xA;WITH m AS (&#xA;    SELECT TOP (1440) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS i&#xA;    FROM sys.all_objects a CROSS JOIN sys.all_objects b&#xA;), c AS (&#xA;    SELECT i / 60 AS hh, i % 60 AS mi, (i / 15) * 15 AS debut_tranche FROM m&#xA;)&#xA;INSERT dw.dim_heure (heure_key, heure, heure_num, minute_num, tranche_15min)&#xA;SELECT CAST(c.hh * 100 + c.mi AS smallint),&#xA;       TIMEFROMPARTS(c.hh, c.mi, 0, 0, 0),&#xA;       c.hh,&#xA;       c.mi,&#xA;       CONCAT(FORMAT(c.debut_tranche / 60, '00'), N':', FORMAT(c.debut_tranche % 60, '00'), N'-',&#xA;              FORMAT(((c.debut_tranche + 15) / 60) % 24, '00'), N':', FORMAT((c.debut_tranche + 15) % 60, '00'))&#xA;FROM c&#xA;WHERE NOT EXISTS (SELECT 1 FROM dw.dim_heure x WHERE x.heure_key = c.hh * 100 + c.mi);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\SEQ_Initialisation\SQL_Generer_Junk_Dimensions"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DTSID="{C946CC0B-1594-4ADA-9A63-D3FE2F707D76}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Generer_Junk_Dimensions"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7186E69B-4145-4297-BC0B-066F953FF763}"
              SQLTask:SqlStatementSource="-- Junk dimensions : toutes les combinaisons d'indicateurs sont générées à l'avance,&#xA;-- les faits n'ont plus qu'à faire un Lookup sur la combinaison.&#xA;-- Idempotent : n'insère que les combinaisons absentes.&#xA;SET NOCOUNT ON;&#xA;&#xA;WITH b AS (SELECT CAST(v AS bit) AS v FROM (VALUES (0), (1)) t(v))&#xA;INSERT dw.dim_flags_pointage (is_retard, is_heures_sup, is_journee_moins_1h, is_duree_negative, is_heure_illisible)&#xA;SELECT b1.v, b2.v, b3.v, b4.v, b5.v&#xA;FROM b b1 CROSS JOIN b b2 CROSS JOIN b b3 CROSS JOIN b b4 CROSS JOIN b b5&#xA;WHERE NOT EXISTS (SELECT 1 FROM dw.dim_flags_pointage f&#xA;                  WHERE f.flags_pointage_sk &gt; 0&#xA;                    AND f.is_retard = b1.v AND f.is_heures_sup = b2.v AND f.is_journee_moins_1h = b3.v&#xA;                    AND f.is_duree_negative = b4.v AND f.is_heure_illisible = b5.v);&#xA;&#xA;WITH b AS (SELECT CAST(v AS bit) AS v FROM (VALUES (0), (1)) t(v)),&#xA;     t AS (SELECT CAST(s AS nvarchar(50)) AS s FROM (VALUES (N'Titularisé'), (N'Non titularisé'), (N'Inconnu')) x(s))&#xA;INSERT dw.dim_flags_effectif (tenure_statut, is_cdi_avec_date_fin, is_contrat_echu_actif, is_vacataire_en_cdi, is_anomalie_contrat)&#xA;SELECT t.s, b1.v, b2.v, b3.v, CAST(CASE WHEN b1.v = 1 OR b2.v = 1 OR b3.v = 1 THEN 1 ELSE 0 END AS bit)&#xA;FROM t CROSS JOIN b b1 CROSS JOIN b b2 CROSS JOIN b b3&#xA;WHERE NOT EXISTS (SELECT 1 FROM dw.dim_flags_effectif f&#xA;                  WHERE f.flags_effectif_sk &gt; 0&#xA;                    AND f.tenure_statut = t.s AND f.is_cdi_avec_date_fin = b1.v&#xA;                    AND f.is_contrat_echu_actif = b2.v AND f.is_vacataire_en_cdi = b3.v);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\SEQ_Initialisation\SQL_Init_Membres_Inconnus"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DTSID="{C1C87920-A8AA-4874-806D-AC21761153A4}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="SQL_Init_Membres_Inconnus"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7186E69B-4145-4297-BC0B-066F953FF763}"
              SQLTask:SqlStatementSource="-- Membres &quot;Inconnu&quot; (sk = -1) : cibles des lignes de faits sans correspondance.&#xA;-- Idempotent : n'insère que les membres absents.&#xA;SET NOCOUNT ON;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_employe WHERE employe_sk = -1)&#xA;BEGIN&#xA;    SET IDENTITY_INSERT dw.dim_employe ON;&#xA;    INSERT dw.dim_employe (employe_sk, employe_bk, population, nom_employe, date_debut, date_fin, is_current)&#xA;    VALUES (-1, N'INCONNU', N'Inconnu', N'Inconnu', '19000101', '99991231', 1);&#xA;    SET IDENTITY_INSERT dw.dim_employe OFF;&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_departement WHERE departement_sk = -1)&#xA;BEGIN&#xA;    SET IDENTITY_INSERT dw.dim_departement ON;&#xA;    INSERT dw.dim_departement (departement_sk, departement_bk, departement, pole, date_debut, date_fin, is_current)&#xA;    VALUES (-1, N'INCONNU', N'Inconnu', N'Inconnu', '19000101', '99991231', 1);&#xA;    SET IDENTITY_INSERT dw.dim_departement OFF;&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_taux_horaire WHERE taux_sk = -1)&#xA;BEGIN&#xA;    SET IDENTITY_INSERT dw.dim_taux_horaire ON;&#xA;    INSERT dw.dim_taux_horaire (taux_sk, code_taux, libelle, valeur_taux, date_debut, date_fin, is_current)&#xA;    VALUES (-1, N'INCONNU', N'Inconnu', NULL, '19000101', '99991231', 1);&#xA;    SET IDENTITY_INSERT dw.dim_taux_horaire OFF;&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_contrat WHERE contrat_sk = -1)&#xA;BEGIN&#xA;    SET IDENTITY_INSERT dw.dim_contrat ON;&#xA;    INSERT dw.dim_contrat (contrat_sk, type_contrat, position, is_contrat_court)&#xA;    VALUES (-1, N'Inconnu', N'Inconnu', 0);&#xA;    SET IDENTITY_INSERT dw.dim_contrat OFF;&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_poste WHERE poste_sk = -1)&#xA;BEGIN&#xA;    SET IDENTITY_INSERT dw.dim_poste ON;&#xA;    INSERT dw.dim_poste (poste_sk, grade, rang, activite) VALUES (-1, N'Inconnu', N'Inconnu', N'Inconnu');&#xA;    SET IDENTITY_INSERT dw.dim_poste OFF;&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_type_conge WHERE type_conge_sk = -1)&#xA;BEGIN&#xA;    SET IDENTITY_INSERT dw.dim_type_conge ON;&#xA;    INSERT dw.dim_type_conge (type_conge_sk, type_conge) VALUES (-1, N'Inconnu');&#xA;    SET IDENTITY_INSERT dw.dim_type_conge OFF;&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_cours WHERE cours_sk = -1)&#xA;BEGIN&#xA;    SET IDENTITY_INSERT dw.dim_cours ON;&#xA;    INSERT dw.dim_cours (cours_sk, cours_bk, nom_cours) VALUES (-1, N'INCONNU', N'Cours inconnu');&#xA;    SET IDENTITY_INSERT dw.dim_cours OFF;&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_competence WHERE competence_sk = -1)&#xA;BEGIN&#xA;    SET IDENTITY_INSERT dw.dim_competence ON;&#xA;    INSERT dw.dim_competence (competence_sk, competence_bk, competence_libelle) VALUES (-1, N'INCONNU', N'Inconnu');&#xA;    SET IDENTITY_INSERT dw.dim_competence OFF;&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_flags_effectif WHERE flags_effectif_sk = -1)&#xA;BEGIN&#xA;    SET IDENTITY_INSERT dw.dim_flags_effectif ON;&#xA;    INSERT dw.dim_flags_effectif (flags_effectif_sk, tenure_statut) VALUES (-1, N'Inconnu');&#xA;    SET IDENTITY_INSERT dw.dim_flags_effectif OFF;&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_flags_pointage WHERE flags_pointage_sk = -1)&#xA;BEGIN&#xA;    SET IDENTITY_INSERT dw.dim_flags_pointage ON;&#xA;    INSERT dw.dim_flags_pointage (flags_pointage_sk) VALUES (-1);&#xA;    SET IDENTITY_INSERT dw.dim_flags_pointage OFF;&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_date WHERE date_key = -1)&#xA;    INSERT dw.dim_date (date_key) VALUES (-1);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dw.dim_heure WHERE heure_key = -1)&#xA;    INSERT dw.dim_heure (heure_key) VALUES (-1);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
