      DTS:CreationName=""
      DTS:Description="Date de snapshot des faits périodiques et date de début des nouvelles versions SCD 2."
      DTS:DTSID="{90E71650-8790-4466-AD23-3C5A27474CB0}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DATE)(@[User::SnapshotDateOverride] == &quot;&quot; ? (DT_WSTR, 10)(DT_DBDATE)GETDATE() : @[User::SnapshotDateOverride])"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SnapshotDate">
      <DTS:VariableValue
        DTS:DataType="7">10/15/2026</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
      DTS:CreationName=""
      DTS:Description="Clé dim_date de la date de snapshot (AAAAMMJJ)."
      DTS:DTSID="{F5ADEDCB-592C-4760-A3C7-4BFB060E3EFE}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="YEAR(@[User::SnapshotDate]) * 10000 + MONTH(@[User::SnapshotDate]) * 100 + DAY(@[User::SnapshotDate])"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SnapshotDateKey">
      <DTS:VariableValue
        DTS:DataType="3">20261015</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable
