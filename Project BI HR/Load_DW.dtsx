                <component
                  refId="Package\SEQ_1_Tables_generees\DFT_DIM_DATE\SRC_Generer_dim_date"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="SRC_Generer_dim_date"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH n AS (SELECT TOP (11323) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS i
           FROM sys.all_columns a CROSS JOIN sys.all_columns b),
d AS (SELECT DATEADD(DAY, i, CAST('2000-01-01' AS date)) AS dt FROM n),
f AS (SELECT dt, DATEDIFF(DAY, '19000101', dt) % 7 + 1 AS js,
             CASE FORMAT(dt, 'MM-dd')
                  WHEN '01-01' THEN N'Jour de l''an'           WHEN '01-14' THEN N'Fête de la Révolution'
                  WHEN '03-20' THEN N'Fête de l''Indépendance' WHEN '04-09' THEN N'Journée des Martyrs'
                  WHEN '05-01' THEN N'Fête du Travail'         WHEN '07-25' THEN N'Fête de la République'
                  WHEN '08-13' THEN N'Fête de la Femme'        WHEN '10-15' THEN N'Fête de l''Évacuation' END AS ferie
      FROM d)
SELECT CAST(YEAR(dt) * 10000 + MONTH(dt) * 100 + DAY(dt) AS int) AS date_sk,
       dt AS date_complete,
       CAST(DAY(dt) AS tinyint) AS jour,
       CAST(js AS tinyint) AS jour_semaine_num,
       CAST(CHOOSE(js, N'Lundi', N'Mardi', N'Mercredi', N'Jeudi', N'Vendredi', N'Samedi', N'Dimanche') AS nvarchar(10)) AS jour_semaine,
       CAST(DATEPART(ISO_WEEK, dt) AS tinyint) AS semaine_iso,
       CAST(MONTH(dt) AS tinyint) AS mois_num,
       CAST(CHOOSE(MONTH(dt), N'Janvier', N'Février', N'Mars', N'Avril', N'Mai', N'Juin', N'Juillet', N'Août',
                   N'Septembre', N'Octobre', N'Novembre', N'Décembre') AS nvarchar(10)) AS mois,
       CAST(DATEPART(QUARTER, dt) AS tinyint) AS trimestre,
       CAST(YEAR(dt) AS smallint) AS annee,
       CAST(CONVERT(char(7), dt, 126) AS char(7)) AS annee_mois,
       CAST(CASE WHEN js &lt;= 5 AND ferie IS NULL THEN 1 ELSE 0 END AS bit) AS est_jour_ouvre,
       CAST(CASE WHEN ferie IS NULL THEN 0 ELSE 1 END AS bit) AS est_ferie,
       CAST(ferie AS nvarchar(60)) AS libelle_ferie
FROM f</property>
