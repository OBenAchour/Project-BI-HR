                    <arrayElement
                      dataType="System.String"><![CDATA[using System;
using System.Collections.Generic;
using System.IO.Compression;
using System.Linq;
using System.Xml.Linq;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void CreateNewOutputRows()
    {
        XNamespace table = "urn:oasis:names:tc:opendocument:xmlns:table:1.0";
        XNamespace text = "urn:oasis:names:tc:opendocument:xmlns:text:1.0";

        using (var zip = ZipFile.OpenRead(Variables.OdsPath))
        using (var s = zip.GetEntry("content.xml").Open())
        {
            var doc = XDocument.Load(s);
            var sheet = doc.Descendants(table + "table")
                           .First(t => (string)t.Attribute(table + "name") == "DEPARTEMENT");

            bool isHeader = true;
            foreach (var row in sheet.Descendants(table + "table-row"))
            {
                var values = new List<string>();
                foreach (var cell in row.Elements(table + "table-cell"))
                {
                    int rep = (int?)cell.Attribute(table + "number-columns-repeated") ?? 1;
                    string v = string.Concat(cell.Elements(text + "p").Select(p => p.Value));
                    if (v == "" && rep > 10) break;
                    for (int i = 0; i < rep; i++) values.Add(v);
                }

                if (values.All(x => x == "")) continue;
                if (isHeader) { isHeader = false; continue; }

                departmentsoutputBuffer.AddRow();
                departmentsoutputBuffer.IDDEP = values.Count > 0 ? values[0] : null;
                departmentsoutputBuffer.DEP = values.Count > 1 ? values[1] : null;
                departmentsoutputBuffer.CAPACITY = values.Count > 2 ? values[2] : null;
            }
        }
    }
}]]></arrayElement>
