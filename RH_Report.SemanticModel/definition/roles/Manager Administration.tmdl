/// Manager de département : voit uniquement l'Administration (DEP_ADMIN00). PPTX slides 20 à 22.
role 'Manager Administration'
	modelPermission: read

	tablePermission 'dw dim_departement' = 'dw dim_departement'[departement_bk] = "DEP_ADMIN00"

	tablePermission 'dw dim_employe' = 'dw dim_employe'[departement_sk] = LOOKUPVALUE('dw dim_departement'[departement_sk], 'dw dim_departement'[departement_bk], "DEP_ADMIN00")

	annotation PBI_Id = 1ca56f29a0f749afbfcf38938dba7dc2

